<remapping.xml>
  <fep_new_year>
    <conditions>
      <condition>
        <conditionName>	nation	</conditionName>
      </condition>
      <condition>
        <conditionName>	outfit	</conditionName>
      </condition>
      <condition>
        <conditionName>	gunName	</conditionName>
      </condition>
      <condition>
        <conditionName>	gunCaliber	</conditionName>
        <remappings>
          <remapping>
            <source>	auto small medium main	</source>
            <target>	main	</target>
          </remapping>
          <remapping>
            <source>	large huge	</source>
            <target>	large	</target>
          </remapping>
        </remappings>
      </condition>
      <condition>
        <conditionName>	shellCaliber	</conditionName>
        <remappings>
          <remapping>
            <source>	auto small medium main	</source>
            <target>	main	</target>
          </remapping>
          <remapping>
            <source>	large huge	</source>
            <target>	large	</target>
          </remapping>
        </remappings>
      </condition>
      <condition>
        <conditionName>	shellKind	</conditionName>
        <remappings>
          <remapping>
            <source>	ARMOR_PIERCING ARMOR_PIERCING_CR ARMOR_PIERCING_HE	</source>
            <target>	AP	</target>
          </remapping>
          <remapping>
            <source>	HOLLOW_CHARGE HIGH_EXPLOSIVE HIGH_EXPLOSIVE_MODERN HIGH_EXPLOSIVE_LEGACY_STUN HIGH_EXPLOSIVE_LEGACY_NO_STUN	</source>
            <target>	HE	</target>
          </remapping>
        </remappings>
      </condition>
      <condition>
        <conditionName>	shellShotsCount	</conditionName>
      </condition>
    </conditions>
    <composers>
      <gunEffects>
        <conditions>	gunCaliber	</conditions>
        <targetTemplate>	fep_ny_shot_{gunCaliber}	</targetTemplate>
        <specialRules>
          <rule>
            <source>	shot_dualgun1_main_L shot_dualgun1_main_mb_L shot_dualgun1_mainext_L shot_dualgun1_mainext_mb_L	</source>
            <target>	fep_ny_shot_dualgun1_main_L	</target>
          </rule>
          <rule>
            <source>	shot_dualgun1_main_R shot_dualgun1_main_mb_R shot_dualgun1_mainext_R shot_dualgun1_mainext_mb_R	</source>
            <target>	fep_ny_shot_dualgun1_main_R	</target>
          </rule>
          <rule>
            <source>	shot_dualgun_main_L shot_dualgun_main_mb_L shot_dualgun_mainext_L shot_dualgun_mainext_mb_L	</source>
            <target>	fep_ny_shot_dualgun_main_L	</target>
          </rule>
          <rule>
            <source>	shot_dualgun_main_R shot_dualgun_main_mb_R shot_dualgun_mainext_R shot_dualgun_mainext_mb_R	</source>
            <target>	fep_ny_shot_dualgun_main_R	</target>
          </rule>
          <rule>
            <source>	shot_dualgun1_large_L shot_dualgun1_large_mb_L	</source>
            <target>	fep_ny_shot_dualgun1_large_L	</target>
          </rule>
          <rule>
            <source>	shot_dualgun1_large_R shot_dualgun1_large_mb_R	</source>
            <target>	fep_ny_shot_dualgun1_large_R	</target>
          </rule>
          <rule>
            <source>	shot_dualgun_large_L shot_dualgun_large_mb_L	</source>
            <target>	fep_ny_shot_dualgun_large_L	</target>
          </rule>
          <rule>
            <source>	shot_dualgun_large_R shot_dualgun_large_mb_R	</source>
            <target>	fep_ny_shot_dualgun_large_R	</target>
          </rule>
          <rule>
            <source>	shot_env_artillery	</source>
            <target>	shot_env_artillery	</target>
          </rule>
        </specialRules>
      </gunEffects>
      <gunMainPrefab>
        <conditions>	nation gunName outfit	</conditions>
        <targetTemplate>	fun_random/content/CGFPrefabs/Vehicle/fep_ny_guns/{nation}/gun{gunName}{outfit}.prefab	</targetTemplate>
        <specialRules>
          <rule>
            <source>	content/CGFPrefabs/Vehicle/guns/uk/gun_01_Twin_20pdr_Gun_MBC_MkII.prefab	</source>
            <target>	fun_random/content/CGFPrefabs/Vehicle/fep_ny_guns/uk/gun_01_Twin_20pdr_Gun_MBC_MkII.prefab	</target>
          </rule>
          <rule>
            <source>	content/CGFPrefabs/Vehicle/guns/uk/gun_02_Twin_32pdr_Gun_MBC.prefab	</source>
            <target>	fun_random/content/CGFPrefabs/Vehicle/fep_ny_guns/uk/gun_02_Twin_32pdr_Gun_MBC.prefab	</target>
          </rule>
          <rule>
            <source>	content/CGFPrefabs/Vehicle/guns/uk/gun_03_Twin_20pdr_Gun_MBC_MkII.prefab	</source>
            <target>	fun_random/content/CGFPrefabs/Vehicle/fep_ny_guns/uk/gun_03_Twin_20pdr_Gun_MBC_MkII.prefab	</target>
          </rule>
          <rule>
            <source>	content/CGFPrefabs/Vehicle/guns/uk/gun_04_Twin_32pdr_Gun_MBC.prefab	</source>
            <target>	fun_random/content/CGFPrefabs/Vehicle/fep_ny_guns/uk/gun_04_Twin_32pdr_Gun_MBC.prefab	</target>
          </rule>
        </specialRules>
      </gunMainPrefab>
      <shotEffects>
        <conditions>	shellCaliber shellKind shellShotsCount	</conditions>
        <targetTemplate>	fep_ny_{shellCaliber}{shellKind}{shellShotsCount}	</targetTemplate>
        <specialRules>
          <rule>
            <source>	mainArmorPiercing1 mainAPCR1 mediumArmorPiercing1 mediumAPCR1	</source>
            <target>	fep_ny_mainAP1	</target>
          </rule>
          <rule>
            <source>	mainHighExplosive1 mediumHighExplosive1	</source>
            <target>	fep_ny_mainHE1	</target>
          </rule>
        </specialRules>
      </shotEffects>
    </composers>
  </fep_new_year>
</remapping.xml>
