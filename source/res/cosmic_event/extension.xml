<extension.xml>
  <FeatureName>	cosmic_event	</FeatureName>
  <IsEnabled>	True	</IsEnabled>
  <Personality>	CosmicEventPersonality	</Personality>
  <EditorPersonality>	editor_cosmic_personality	</EditorPersonality>
  <Components>
    <StaticComponents>
      <AccountCosmicEventComponent></AccountCosmicEventComponent>
      <ArenaCosmicEventComponent></ArenaCosmicEventComponent>
    </StaticComponents>
    <DynamicComponents>
      <VehicleCosmicEventComponent></VehicleCosmicEventComponent>
      <ArenaInfoScoreSystemComponent></ArenaInfoScoreSystemComponent>
      <ArenaVehicleShieldsController></ArenaVehicleShieldsController>
      <VehicleImpulseScheduler></VehicleImpulseScheduler>
      <VehicleSpawnProtection></VehicleSpawnProtection>
      <ArenaLootControllerComponent></ArenaLootControllerComponent>
      <ArtifactScanningComponent></ArtifactScanningComponent>
      <VehicleOverrideShotComponent></VehicleOverrideShotComponent>
      <EquipVehicleCtrlComponent></EquipVehicleCtrlComponent>
      <VehicleStunShotComponent></VehicleStunShotComponent>
      <BoosterComponent></BoosterComponent>
      <ArenaMeteoriteZoneCtrlComponent></ArenaMeteoriteZoneCtrlComponent>
      <CosmicVehicleResearchableLootComponent></CosmicVehicleResearchableLootComponent>
      <CosmicVehicleTeleportAbilityComponent></CosmicVehicleTeleportAbilityComponent>
      <VehicleAfkControllerComponent></VehicleAfkControllerComponent>
      <VehicleRotationComponent></VehicleRotationComponent>
    </DynamicComponents>
  </Components>
  <Entities>
    <ClientServerEntities>
      <CosmicLoot></CosmicLoot>
      <ClientSelectableArtifactMachine></ClientSelectableArtifactMachine>
      <MeteoriteZone></MeteoriteZone>
      <RepulsionMine></RepulsionMine>
    </ClientServerEntities>
    <ServerOnlyEntities>
      <CosmicEventBattlesMgr></CosmicEventBattlesMgr>
    </ServerOnlyEntities>
  </Entities>
  <ExternalComponents></ExternalComponents>
  <gui>
    <paths></paths>
    <overrideAlias></overrideAlias>
    <context_menu></context_menu>
    <handler></handler>
  </gui>
  <cgf>
    <script>
      <module>	cell.cosmic_event_cell_cgf.components	</module>
      <module>	cell.cosmic_event_cell_cgf.managers	</module>
      <module>	client.cosmic_event_client_cgf.components	</module>
      <module>	client.cosmic_event_client_cgf.managers	</module>
      <module>	common.cosmic_event_common_cgf.components	</module>
      <module>	common.cosmic_event_common_cgf.managers	</module>
      <module>	common.cosmic_event_common_cgf.rules	</module>
      <module>	cell.cosmic_event_cell_cgf.boosters.components	</module>
      <module>	cell.cosmic_event_cell_cgf.boosters.managers	</module>
      <module>	client.cosmic_event_client_cgf.boosters.components	</module>
      <module>	client.cosmic_event_client_cgf.boosters.managers	</module>
      <module>	common.cosmic_event_common_cgf.boosters.components	</module>
      <module>	common.cosmic_event_common_cgf.boosters.managers	</module>
    </script>
    <prefabFolders>
      <path>	content/CGFPrefabs/cosmic_event	</path>
    </prefabFolders>
  </cgf>
</extension.xml>
