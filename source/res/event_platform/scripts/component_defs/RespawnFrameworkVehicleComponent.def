<RespawnFrameworkVehicleComponent.def>
  <Parent>	VehicleRespawnComponent	</Parent>
  <CellMethods>
    <applySelectedLoadout>
      <Exposed></Exposed>
      <Arg>	INT32	</Arg>
      <Arg>	FIXED_DICT	  <implementedBy>	true_dict.instance	</implementedBy>
        <Properties>
          <keys>
            <Type>	ARRAY	  <of>	INT32	</of>
            </Type>
          </keys>
          <values>
            <Type>	ARRAY	  <of>	PYTHON	</of>
            </Type>
          </values>
        </Properties>
      </Arg>
      <AllowUnsafeData>	true	</AllowUnsafeData>
    </applySelectedLoadout>
  </CellMethods>
  <Properties>
    <respawnVehicles>
      <Type>	PYTHON	</Type>
      <Flags>	ALL_CLIENTS	</Flags>
      <DetailLevel>	MY_VEHICLE	</DetailLevel>
      <AllowUnsafeData>	true	</AllowUnsafeData>
    </respawnVehicles>
    <selectedRespawnVehicleCD>
      <Type>	INT32	</Type>
      <Flags>	ALL_CLIENTS	</Flags>
    </selectedRespawnVehicleCD>
  </Properties>
  <ofEntity>
    <Vehicle></Vehicle>
  </ofEntity>
  <DefaultKeyName>	VehicleRespawnComponent	</DefaultKeyName>
</RespawnFrameworkVehicleComponent.def>
