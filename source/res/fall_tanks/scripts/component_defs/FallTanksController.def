<FallTanksController.def>
  <DetailLevel>	MY_VEHICLE	</DetailLevel>
  <Properties>
    <evacuationState>
      <Type>	FALL_TANKS_EVACUATION_INFO	</Type>
      <Flags>	ALL_CLIENTS	</Flags>
    </evacuationState>
  </Properties>
  <CellMethods>
    <initiateVehicleEvacuation>
      <Exposed>	OWN_CLIENT	</Exposed>
    </initiateVehicleEvacuation>
    <cancelVehicleEvacuation>
      <Exposed>	OWN_CLIENT	</Exposed>
    </cancelVehicleEvacuation>
  </CellMethods>
  <ofEntity>
    <Vehicle></Vehicle>
  </ofEntity>
  <DefaultKeyName>	FallTanksController	</DefaultKeyName>
</FallTanksController.def>
