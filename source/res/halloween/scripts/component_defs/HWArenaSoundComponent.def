<HWArenaSoundComponent.def>
  <ClientMethods>
    <onBotCreated>
      <Args>
        <vehicleType>	STRING	</vehicleType>
        <position>	VECTOR3	</position>
      </Args>
    </onBotCreated>
    <onBossAuraIntersect>
      <Arg>	INT32	</Arg>
      <Arg>	BOOL	</Arg>
    </onBossAuraIntersect>
    <onPlaySoundEvent>
      <Arg>	STRING	</Arg>
    </onPlaySoundEvent>
    <onPlayVoiceover>
      <Arg>	STRING	</Arg>
      <Arg>	STRING	</Arg>
      <Arg>	BOOL	</Arg>
    </onPlayVoiceover>
  </ClientMethods>
  <Properties>
    <ongoingSoundEvents>
      <Type>	ARRAY	  <of>	STRING	</of>
      </Type>
      <Flags>	ALL_CLIENTS	</Flags>
    </ongoingSoundEvents>
  </Properties>
  <ofEntity>
    <ArenaInfo></ArenaInfo>
  </ofEntity>
</HWArenaSoundComponent.def>
