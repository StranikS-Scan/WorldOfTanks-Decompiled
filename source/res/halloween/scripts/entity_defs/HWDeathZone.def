<HWDeathZone.def>
  <AppealRadius>	3000	</AppealRadius>
  <Properties>
    <serverTransform>
      <Type>	FIXED_DICT	  <Properties>
          <position>
            <Type>	VECTOR3	</Type>
          </position>
          <size>
            <Type>	VECTOR3	</Type>
          </size>
          <rotation>
            <Type>	FLOAT	</Type>
          </rotation>
        </Properties>
      </Type>
      <Flags>	ALL_CLIENTS	</Flags>
    </serverTransform>
    <shape>
      <Type>	UINT8	</Type>
      <Flags>	ALL_CLIENTS	</Flags>
    </shape>
    <requestedTransform>
      <Type>	FIXED_DICT	  <Properties>
          <position>
            <Type>	VECTOR3	</Type>
          </position>
          <size>
            <Type>	VECTOR3	</Type>
          </size>
          <rotation>
            <Type>	FLOAT	</Type>
          </rotation>
