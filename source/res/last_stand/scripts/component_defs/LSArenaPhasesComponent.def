<LSArenaPhasesComponent.def>
  <ClientMethods>
    <hideVehicleOnMinimap>
      <Args>
        <vehicleID>	OBJECT_ID	</vehicleID>
      </Args>
    </hideVehicleOnMinimap>
    <cleanBCMarkers></cleanBCMarkers>
  </ClientMethods>
  <CellMethods></CellMethods>
  <Properties>
    <activePhase>
      <Type>	UINT8	</Type>
      <Flags>	ALL_CLIENTS	</Flags>
      <Default>	1	</Default>
      <MinValue>	1	</MinValue>
    </activePhase>
    <phasesCount>
      <Type>	UINT8	</Type>
      <Flags>	ALL_CLIENTS	</Flags>
      <MinValue>	1	</MinValue>
    </phasesCount>
    <phaseDuration>
      <Type>	UINT32	</Type>
      <Flags>	ALL_CLIENTS	</Flags>
      <MinValue>	1	</MinValue>
    </phaseDuration>
    <timeLeft>
      <Type>	INT32	</Type>
      <Flags>	ALL_CLIENTS	</Flags>
      <MinValue>	1	</MinValue>
    </timeLeft>
    <isTimerAlarmEnabled>
      <Type>	BOOL	</Type>
      <Flags>	ALL_CLIENTS	</Flags>
      <Default>	0	</Default>
    </isTimerAlarmEnabled>
    <isRespawnEnabled>
      <Type>	BOOL	</Type>
      <Flags>	ALL_CLIENTS	</Flags>
      <Default>	1	</Default>
    </isRespawnEnabled>
    <activeEnvironment>
      <Type>	STRING	</Type>
      <Flags>	ALL_CLIENTS	</Flags>
      <Default></Default>
    </activeEnvironment>
    <isBCMarkersCleanupEnabled>
      <Type>	BOOL	</Type>
      <Flags>	ALL_CLIENTS	</Flags>
      <Default>	0	</Default>
    </isBCMarkersCleanupEnabled>
  </Properties>
  <ofEntity>
    <ArenaInfo></ArenaInfo>
  </ofEntity>
</LSArenaPhasesComponent.def>
