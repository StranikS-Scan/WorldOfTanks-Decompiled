<LSWaveProgressComponent.def>
  <ClientMethods></ClientMethods>
  <CellMethods></CellMethods>
  <Properties>
    <enemiesInfo>
      <Type>	FIXED_DICT	  <Properties>
          <aliveEnemies>
            <Type>	UINT8	</Type>
          </aliveEnemies>
          <totalEnemies>
            <Type>	UINT8	</Type>
          </totalEnemies>
          <currentHealth>
            <Type>	INT32	</Type>
          </currentHealth>
          <totalHealth>
            <Type>	INT32	</Type>
          </totalHealth>
        </Properties>
      </Type>
      <Flags>	ALL_CLIENTS	</Flags>
    </enemiesInfo>
    <healthBreakpoints>
      <Type>	ARRAY	  <of>	INT32	</of>
      </Type>
      <Flags>	ALL_CLIENTS	</Flags>
    </healthBreakpoints>
    <enemiesStatus>
      <Type>	ARRAY	  <of>	FIXED_DICT	  <Properties>
            <role>
              <Type>	STRING	</Type>
            </role>
            <isDead>
              <Type>	BOOL	</Type>
            </isDead>
          </Properties>
        </of>
      </Type>
      <Flags>	ALL_CLIENTS	</Flags>
    </enemiesStatus>
  </Properties>
  <ofEntity>
    <ArenaInfo></ArenaInfo>
  </ofEntity>
</LSWaveProgressComponent.def>
