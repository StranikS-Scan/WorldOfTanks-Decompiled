<GuidedMissileReplicableComponent.def>
  <Properties>
    <replicableAvatarId>
      <Type>	OBJECT_ID	</Type>
      <Flags>	ALL_CLIENTS	</Flags>
      <SendLatestOnly>	true	</SendLatestOnly>
    </replicableAvatarId>
    <isDeploying>
      <Type>	BOOL	</Type>
      <Flags>	ALL_CLIENTS	</Flags>
      <SendLatestOnly>	true	</SendLatestOnly>
    </isDeploying>
    <flightFinishTime>
      <Type>	FLOAT32	</Type>
      <Flags>	ALL_CLIENTS	</Flags>
    </flightFinishTime>
    <isDetonateProjectile>
      <Type>	BOOL	</Type>
      <Flags>	ALL_CLIENTS	</Flags>
      <default>	FALSE	</default>
    </isDetonateProjectile>
  </Properties>
  <CellMethods>
    <setDirection>
      <Exposed>	OWN_CLIENT	</Exposed>
      <Arg>	OBJECT_ID	</Arg>
      <Arg>	VECTOR3	</Arg>
    </setDirection>
    <startBoostEffect>
      <Exposed>	OWN_CLIENT	</Exposed>
      <Arg>	OBJECT_ID	</Arg>
    </startBoostEffect>
    <endBoostEffect>
      <Exposed>	OWN_CLIENT	</Exposed>
      <Arg>	OBJECT_ID	</Arg>
    </endBoostEffect>
    <detonateProjectile>
      <Exposed>	OWN_CLIENT	</Exposed>
      <Arg>	OBJECT_ID	</Arg>
    </detonateProjectile>
  </CellMethods>
  <DefaultKeyName>	guidedMissileReplicableComponent	</DefaultKeyName>
</GuidedMissileReplicableComponent.def>
