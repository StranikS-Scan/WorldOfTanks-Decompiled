<TeleportReplicableComponent.def>
  <Properties>
    <isTeleportLinked>
      <Type>	BOOL	</Type>
      <Flags>	ALL_CLIENTS	</Flags>
    </isTeleportLinked>
    <index>
      <Type>	UINT8	</Type>
      <Flags>	ALL_CLIENTS	</Flags>
      <Default>	0	</Default>
    </index>
    <isCooldown>
      <Type>	BOOL	</Type>
      <Flags>	ALL_CLIENTS	</Flags>
      <default>	FALSE	</default>
    </isCooldown>
    <teleportingFinishTime>
      <Type>	FLOAT32	</Type>
      <Flags>	ALL_CLIENTS	</Flags>
    </teleportingFinishTime>
    <teleportingVehicleID>
      <Type>	OBJECT_ID	</Type>
      <Flags>	ALL_CLIENTS	</Flags>
    </teleportingVehicleID>
  </Properties>
  <CellMethods></CellMethods>
  <DefaultKeyName>	teleportReplicableComponent	</DefaultKeyName>
</TeleportReplicableComponent.def>
