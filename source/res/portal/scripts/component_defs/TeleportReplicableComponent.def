<TeleportReplicableComponent.def>
  <Properties>
    <isTeleportLinked>
      <Type>	BOOL	</Type>
      <Flags>	ALL_CLIENTS	</Flags>
    </isTeleportLinked>
    <index>
      <Type>	UINT8	</Type>
      <Flags>	ALL_CLIENTS	</Flags>
      <Default>	0	</Default>
    </index>
    <cooldownVehicleIDs>
      <Type>	ARRAY	  <of>	OBJECT_ID	</of>
      </Type>
      <Flags>	ALL_CLIENTS	</Flags>
    </cooldownVehicleIDs>
    <cooldownStartTimes>
      <Type>	ARRAY	  <of>	FLOAT32	</of>
      </Type>
      <Flags>	ALL_CLIENTS	</Flags>
    </cooldownStartTimes>
    <cooldownFinishTimes>
      <Type>	ARRAY	  <of>	FLOAT32	</of>
      </Type>
      <Flags>	ALL_CLIENTS	</Flags>
    </cooldownFinishTimes>
    <teleportingVehicleIDs>
      <Type>	ARRAY	  <of>	OBJECT_ID	</of>
      </Type>
      <Flags>	ALL_CLIENTS	</Flags>
    </teleportingVehicleIDs>
    <teleportingStartTimes>
      <Type>	ARRAY	  <of>	FLOAT32	</of>
      </Type>
      <Flags>	ALL_CLIENTS	</Flags>
    </teleportingStartTimes>
    <teleportingFinishTimes>
      <Type>	ARRAY	  <of>	FLOAT32	</of>
      </Type>
      <Flags>	ALL_CLIENTS	</Flags>
    </teleportingFinishTimes>
  </Properties>
  <CellMethods></CellMethods>
  <DefaultKeyName>	teleportReplicableComponent	</DefaultKeyName>
</TeleportReplicableComponent.def>
