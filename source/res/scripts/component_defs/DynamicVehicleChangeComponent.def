    </originalVehicleID>
    <oldVehicleID>
      <Type>	OBJECT_ID	</Type>
      <Flags>	OWN_CLIENT	</Flags>
    </oldVehicleID>
    <newVehicleID>
      <Type>	OBJECT_ID	</Type>
      <Flags>	OWN_CLIENT	</Flags>
    </newVehicleID>
    <isControllingVehicle>
      <Type>	BOOL	</Type>
      <Flags>	OWN_CLIENT	</Flags>
    </isControllingVehicle>
    <isControlInterrupted>
      <Type>	BOOL	</Type>
