<StagedJetBoostersController.def>
  <Implements>
    <Interface>	ReplicableComponent	</Interface>
  </Implements>
  <Properties>
    <stateStatus>
      <Type>	ROCKET_ACCELERATION_STATE_STATUS	</Type>
      <Flags>	ALL_CLIENTS	</Flags>
    </stateStatus>
    <acceleratorStatus>
      <Type>	UINT8	</Type>
      <Flags>	ALL_CLIENTS	</Flags>
    </acceleratorStatus>
  </Properties>
  <CellMethods>
    <tryActivate>
      <Exposed>	OWN_CLIENT	</Exposed>
    </tryActivate>
  </CellMethods>
  <DefaultKeyName>	stagedJetBoostersController	</DefaultKeyName>
</StagedJetBoostersController.def>
