<DelayedBomb.def>
  <Properties>
    <ownerVehicleID>
      <Type>	UINT32	</Type>
      <Flags>	CELL_PRIVATE	</Flags>
    </ownerVehicleID>
    <shellCompDescr>
      <Type>	UINT32	</Type>
      <Flags>	ALL_CLIENTS	</Flags>
    </shellCompDescr>
    <shotID>
      <Type>	UINT32	</Type>
      <Flags>	ALL_CLIENTS	</Flags>
    </shotID>
    <team>
      <Type>	UINT32	</Type>
      <Flags>	ALL_CLIENTS	</Flags>
    </team>
  </Properties>
  <CellMethods></CellMethods>
  <ClientMethods></ClientMethods>
  <TempProperties></TempProperties>
  <shouldBackup>	false	</shouldBackup>
</DelayedBomb.def>
