<NetworkEntity.def>
  <AppealRadius>	3000	</AppealRadius>
  <shouldBackup>	false	</shouldBackup>
  <Implements></Implements>
  <Volatile>
    <position></position>
    <yaw></yaw>
    <roll></roll>
    <pitch></pitch>
  </Volatile>
  <Properties>
    <unique_id>
      <Type>	STRING	</Type>
      <Flags>	ALL_CLIENTS	</Flags>
    </unique_id>
    <prefab_path>
      <Type>	STRING	</Type>
      <Flags>	ALL_CLIENTS	</Flags>
    </prefab_path>
    <scale>
      <Type>	VECTOR3	</Type>
      <Flags>	ALL_CLIENTS	</Flags>
    </scale>
    <useDetailedPosition>
      <Type>	BOOL	</Type>
      <Flags>	CELL_PRIVATE	</Flags>
      <default>	FALSE	</default>
    </useDetailedPosition>
    <name>
      <Type>	STRING	</Type>
      <Flags>	ALL_CLIENTS	</Flags>
    </name>
  </Properties>
  <ClientMethods></ClientMethods>
  <CellMethods></CellMethods>
</NetworkEntity.def>
