<tankAcademyResearchVehicle.xml>
  <default-scene>	DefaultScene	</default-scene>
  <initial-scene>	MissionsPage	</initial-scene>
  <scenes>
    <scene>	MissionsPage	  <post-effects>
        <inactivate>	MenuHangarOnScene	</inactivate>
        <inactivate>	HangarButtonWasClicked	</inactivate>
        <inactivate>	VehicleResearchButtonOnScene	</inactivate>
        <inactivate>	TankCarouselOnScene	</inactivate>
        <inactivate>	VehicleResearchButtonClicked	</inactivate>
        <inactivate>	ResearchItemNodeButtonOnScene	</inactivate>
        <inactivate>	BuyVehicleButtonOnScene	</inactivate>
        <inactivate>	SimpleDialogSecondButtonOnScene	</inactivate>
        <inactivate>	ResearchVehicleDialogOpening	</inactivate>
        <inactivate>	VehicleResearched	</inactivate>
        <inactivate>	BuyVehicleClicked	</inactivate>
      </post-effects>
      <runtime-effects>
        <show-hint>	MenuHangarHint	  <condition>
            <active>	MenuHangarOnScene	</active>
          </condition>
        </show-hint>
      </runtime-effects>
      <gui-items>
        <gui-item>	MenuHangar	  <on-scene-effects>
            <activate>	MenuHangarOnScene	</activate>
          </on-scene-effects>
          <not-on-scene-effects>
            <inactivate>	MenuHangarOnScene	</inactivate>
          </not-on-scene-effects>
        </gui-item>
      </gui-items>
    </scene>
    <scene>	Hangar	  <post-effects>
        <refuse-training>
          <condition>
            <inactive>	HangarButtonWasClicked	</inactive>
          </condition>
        </refuse-training>
        <inactivate>	HangarButtonWasClicked	</inactivate>
        <set-var>	CurrentVehicleCDSetter	</set-var>
        <run-trigger>	CurrentVehicleChangeTrigger	</run-trigger>
      </post-effects>
      <runtime-effects>
        <show-hint>	VehicleResearchButtonHint	  <condition>
            <active>	VehicleResearchButtonOnScene	</active>
            <inactive>	VehicleResearchButtonClicked	</inactive>
            <game-item>	CurrentVehicleCD	  <level>	RequiredVehicleLevel	</level>
            </game-item>
            <game-item>	CurrentVehicleCD	  <not-premium></not-premium>
            </game-item>
          </condition>
        </show-hint>
        <show-hint>	TankCarouselHint	  <condition>
            <active>	TankCarouselOnScene	</active>
            <either>
              <game-item>	CurrentVehicleCD	  <not-level>	RequiredVehicleLevel	</not-level>
              </game-item>
              <game-item>	CurrentVehicleCD	  <premium></premium>
              </game-item>
            </either>
          </condition>
        </show-hint>
      </runtime-effects>
      <gui-items>
        <gui-item>	VehicleResearchButton	  <on-scene-effects>
            <activate>	VehicleResearchButtonOnScene	</activate>
          </on-scene-effects>
          <not-on-scene-effects>
            <inactivate>	VehicleResearchButtonOnScene	</inactivate>
          </not-on-scene-effects>
        </gui-item>
        <gui-item>	TankCarousel	  <on-scene-effects>
            <activate>	TankCarouselOnScene	</activate>
          </on-scene-effects>
          <not-on-scene-effects>
            <inactivate>	TankCarouselOnScene	</inactivate>
          </not-on-scene-effects>
        </gui-item>
      </gui-items>
    </scene>
    <scene>	Research	  <post-effects>
        <set-var>	CurrentResearchVehicleSetter	</set-var>
        <set-gui-item-criteria>	ResearchVehicleNodeCriteria	</set-gui-item-criteria>
        <run-trigger>	ItemsCacheSyncTrigger	</run-trigger>
        <run-trigger>	ResearchGoToNextVehicleTrigger	</run-trigger>
      </post-effects>
      <runtime-effects>
        <show-hint>	ResearchVehicleHint	  <condition>
            <active>	ResearchItemNodeButtonOnScene	</active>
            <inactive>	SimpleDialogSecondButtonOnScene	</inactive>
            <inactive>	ResearchVehicleDialogOpening	</inactive>
            <inactive>	VehicleResearched	</inactive>
            <inactive>	BuyVehicleClicked	</inactive>
            <game-item>	CurrentVehicleCD	  <level>	RequiredVehicleLevel	</level>
            </game-item>
            <game-item>	CurrentVehicleCD	  <not-premium></not-premium>
            </game-item>
          </condition>
        </show-hint>
        <show-hint>	BuyVehicleHint	  <condition>
            <active>	BuyVehicleButtonOnScene	</active>
            <inactive>	SimpleDialogSecondButtonOnScene	</inactive>
            <active>	VehicleResearched	</active>
            <inactive>	BuyVehicleClicked	</inactive>
          </condition>
        </show-hint>
      </runtime-effects>
      <gui-items>
        <gui-item>	ResearchItemNode	  <on-scene-effects>
            <activate>	ResearchItemNodeButtonOnScene	</activate>
          </on-scene-effects>
          <not-on-scene-effects>
            <inactivate>	ResearchItemNodeButtonOnScene	</inactivate>
          </not-on-scene-effects>
        </gui-item>
        <gui-item>	TankAcademyResearchItemNodeButton	  <on-scene-effects>
            <activate>	BuyVehicleButtonOnScene	</activate>
          </on-scene-effects>
          <not-on-scene-effects>
            <inactivate>	BuyVehicleButtonOnScene	</inactivate>
          </not-on-scene-effects>
        </gui-item>
        <gui-item>	SimpleDialogSecondButton	  <on-scene-effects>
            <activate>	SimpleDialogSecondButtonOnScene	</activate>
          </on-scene-effects>
          <not-on-scene-effects>
            <inactivate>	SimpleDialogSecondButtonOnScene	</inactivate>
            <inactivate>	ResearchVehicleDialogOpening	</inactivate>
          </not-on-scene-effects>
        </gui-item>
      </gui-items>
    </scene>
    <scene>	DefaultScene	  <post-effects>
        <refuse-training></refuse-training>
      </post-effects>
      <runtime-effects></runtime-effects>
      <gui-items></gui-items>
    </scene>
  </scenes>
  <has-id>
    <hint>	MenuHangarHint	  <item-id>	MenuHangar	</item-id>
      <hide-immediately>	True	</hide-immediately>
      <update-runtime>	True	</update-runtime>
      <text>	Перейдите в Ангар	</text>
      <arrow>
        <direction>	B	</direction>
        <loop>	True	</loop>
      </arrow>
      <actions>
        <click>	MenuHangar	  <effects>
            <activate>	HangarButtonWasClicked	</activate>
            <close-hint>	MenuHangarHint	</close-hint>
          </effects>
        </click>
        <esc>	MenuHangar	  <effects>
            <refuse-training></refuse-training>
          </effects>
        </esc>
        <click>	BattleSelectorBar	  <effects>
            <refuse-training></refuse-training>
          </effects>
        </click>
      </actions>
    </hint>
    <hint>	VehicleResearchButtonHint	  <item-id>	VehicleResearchButton	</item-id>
      <text>	Перейдите на экран исследований	</text>
      <update-runtime>	True	</update-runtime>
      <padding>
        <left>	-225	</left>
        <top>	-5	</top>
        <right>	-35	</right>
        <bottom>	-5	</bottom>
      </padding>
      <arrow>
        <direction>	L	</direction>
        <loop>	True	</loop>
      </arrow>
      <actions>
        <click>	VehicleResearchButton	  <effects>
            <close-hint>	VehicleResearchButtonHint	</close-hint>
            <activate>	VehicleResearchButtonClicked	</activate>
            <set-var>	CurrentResearchVehicleSetter	</set-var>
            <set-gui-item-criteria>	ResearchVehicleNodeCriteria	</set-gui-item-criteria>
          </effects>
        </click>
        <esc>	VehicleResearchButton	  <effects>
            <refuse-training></refuse-training>
          </effects>
        </esc>
      </actions>
    </hint>
    <hint>	ResearchVehicleHint	  <item-id>	ResearchItemNode	</item-id>
      <text>	Исследуйте любую технику&lt;br/&gt;следующего уровня, например эту машину	</text>
      <hide-immediately>	True	</hide-immediately>
      <update-runtime>	True	</update-runtime>
      <padding>
        <left>	0	</left>
        <top>	0	</top>
        <right>	29	</right>
        <bottom>	30	</bottom>
      </padding>
      <arrow>
        <direction>	T	</direction>
        <loop>	True	</loop>
      </arrow>
      <actions>
        <click>	ResearchItemNode	  <effects>
            <close-hint>	ResearchVehicleHint	</close-hint>
            <activate>	ResearchVehicleDialogOpening	</activate>
          </effects>
        </click>
        <esc>	ResearchItemNode	  <effects>
            <refuse-training></refuse-training>
          </effects>
        </esc>
      </actions>
    </hint>
    <hint>	BuyVehicleHint	  <item-id>	TankAcademyResearchItemNodeButton	</item-id>
      <text>	Купите эту машину	</text>
      <hide-immediately>	True	</hide-immediately>
      <update-runtime>	True	</update-runtime>
      <arrow>
        <direction>	T	</direction>
        <loop>	True	</loop>
      </arrow>
      <actions>
        <click>	TankAcademyResearchItemNodeButton	  <effects>
            <close-hint>	BuyVehicleHint	</close-hint>
            <inactivate>	ResearchVehicleDialogOpening	</inactivate>
            <activate>	BuyVehicleClicked	</activate>
            <refuse-training></refuse-training>
          </effects>
        </click>
        <esc>	TankAcademyResearchItemNodeButton	  <effects>
            <refuse-training></refuse-training>
          </effects>
        </esc>
      </actions>
    </hint>
    <hint>	TankCarouselHint	  <item-id>	TankCarousel	</item-id>
      <text>	Выберите исследуемую машину $RequiredVehicleLevelRoman$ уровня	</text>
      <hide-immediately>	True	</hide-immediately>
      <update-runtime>	True	</update-runtime>
      <arrow>
        <direction>	T	</direction>
        <loop>	True	</loop>
      </arrow>
      <actions>
        <esc>	TankCarousel	  <effects>
            <refuse-training></refuse-training>
          </effects>
        </esc>
      </actions>
    </hint>
    <game-attribute>	CurrentVehicleCDSetter	  <var-ref>	CurrentVehicleCD	</var-ref>
      <name>	CurrentVehicleCD	</name>
    </game-attribute>
    <game-attribute>	CurrentResearchVehicleSetter	  <var-ref>	ResearchVehicleCD	</var-ref>
      <name>	CurrentResearchVehicle	</name>
    </game-attribute>
    <gui-item-criteria>	ResearchVehicleNodeCriteria	  <item-id>	ResearchItemNodeID	</item-id>
      <value>	id=$ResearchVehicleCD$	</value>
    </gui-item-criteria>
  </has-id>
  <triggers>
    <trigger>	CurrentVehicleChangeTrigger	  <type>	current-vehicle-changed	</type>
      <validate-var></validate-var>
      <unlock-targets>
        <unlock-target>	TankCarousel	</unlock-target>
        <unlock-target>	VehicleResearchButton	</unlock-target>
      </unlock-targets>
      <on-effects>
        <set-var>	CurrentVehicleCDSetter	</set-var>
        <close-hint>	TankCarouselHint	  <condition>
            <game-item>	CurrentVehicleCD	  <level>	RequiredVehicleLevel	</level>
            </game-item>
            <game-item>	CurrentVehicleCD	  <not-premium></not-premium>
            </game-item>
          </condition>
        </close-hint>
        <close-hint>	VehicleResearchButtonHint	</close-hint>
      </on-effects>
    </trigger>
    <trigger>	ItemsCacheSyncTrigger	  <type>	items-cache-sync	</type>
      <validate-var></validate-var>
      <unlock-targets>
        <unlock-target>	ResearchItemNode	</unlock-target>
        <unlock-target>	TankAcademyResearchItemNodeButton	</unlock-target>
      </unlock-targets>
      <on-effects>
        <close-hint>	ResearchVehicleHint	  <condition>
            <game-item>	ResearchVehicleCD	  <unlocked></unlocked>
            </game-item>
          </condition>
        </close-hint>
        <activate>	VehicleResearched	  <condition>
            <game-item>	ResearchVehicleCD	  <unlocked></unlocked>
            </game-item>
          </condition>
        </activate>
        <inactivate>	ResearchVehicleDialogOpening	  <condition>
            <game-item>	ResearchVehicleCD	  <unlocked></unlocked>
            </game-item>
          </condition>
        </inactivate>
      </on-effects>
    </trigger>
    <trigger>	ResearchGoToNextVehicleTrigger	  <type>	research-go-to-next-vehicle	</type>
      <validate-var></validate-var>
      <unlock-targets>
        <unlock-target>	ResearchItemNode	</unlock-target>
        <unlock-target>	TankAcademyResearchItemNodeButton	</unlock-target>
      </unlock-targets>
      <on-effects>
        <close-hint>	ResearchVehicleHint	</close-hint>
        <close-hint>	BuyVehicleHint	</close-hint>
        <refuse-training></refuse-training>
      </on-effects>
    </trigger>
  </triggers>
  <vars></vars>
</tankAcademyResearchVehicle.xml>
