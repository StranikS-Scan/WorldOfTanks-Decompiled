<extension.xml>
  <FeatureName>	white_tiger	</FeatureName>
  <IsEnabled>	true	</IsEnabled>
  <Personality>	WhiteTigerPersonality	</Personality>
  <EditorPersonality>	editor_white_tiger_personality	</EditorPersonality>
  <Entities>
    <ClientServerEntities></ClientServerEntities>
    <ServerOnlyEntities>
      <WhiteTigerUnitMgr></WhiteTigerUnitMgr>
      <WhiteTigerBattlesMgr></WhiteTigerBattlesMgr>
    </ServerOnlyEntities>
  </Entities>
  <Components>
    <StaticComponents>
      <AccountWhiteTigerComponent></AccountWhiteTigerComponent>
      <ArenaWhiteTigerComponent></ArenaWhiteTigerComponent>
    </StaticComponents>
    <DynamicComponents>
      <EntityWTGeneratorComponent></EntityWTGeneratorComponent>
      <GeneratorDestroyedComponent></GeneratorDestroyedComponent>
      <TeamInfoWTPlasmaBonusComponentController></TeamInfoWTPlasmaBonusComponentController>
      <VehicleWTGeneratorActivation></VehicleWTGeneratorActivation>
      <VehicleWTStatCollectorHarrier></VehicleWTStatCollectorHarrier>
      <VehicleWTStatTotalGeneratorsCaptured></VehicleWTStatTotalGeneratorsCaptured>
      <VehicleWTUnionStrengthMarkComponent></VehicleWTUnionStrengthMarkComponent>
      <VehicleWTPlasmaExtractorComponent></VehicleWTPlasmaExtractorComponent>
      <WTVehicleAfkController></WTVehicleAfkController>
      <VehicleWTStunAreaComponent></VehicleWTStunAreaComponent>
      <VehicleWTStunAreaDebuffComponent></VehicleWTStunAreaDebuffComponent>
      <VehicleWTAbilitiesManagerComponent></VehicleWTAbilitiesManagerComponent>
      <WTVisualEffect></WTVisualEffect>
    </DynamicComponents>
  </Components>
  <ExternalComponents></ExternalComponents>
  <cgf>
    <script>
      <module>	client.cgf_components.wt_collision_component	</module>
    </script>
  </cgf>
</extension.xml>
