<WTCaptureProgressComponent.def>
  <Properties>
    <activationProgress>
      <Type>	FIXED_DICT	  <Properties>
          <progress>
            <Type>	UINT8	</Type>
          </progress>
          <timeLeft>
            <Type>	UINT8	</Type>
          </timeLeft>
          <numInvaders>
            <Type>	UINT8	</Type>
          </numInvaders>
          <invadersVehicleIDs>
            <Type>	ARRAY	  <of>	OBJECT_ID	</of>
            </Type>
          </invadersVehicleIDs>
        </Properties>
      </Type>
      <Flags>	ALL_CLIENTS	</Flags>
    </activationProgress>
    <isCaptured>
      <Type>	BOOL	</Type>
      <Flags>	ALL_CLIENTS	</Flags>
      <Default>	0	</Default>
    </isCaptured>
  </Properties>
  <ofEntity>
    <Entity></Entity>
  </ofEntity>
  <DefaultKeyName>	captureProgress	</DefaultKeyName>
</WTCaptureProgressComponent.def>
