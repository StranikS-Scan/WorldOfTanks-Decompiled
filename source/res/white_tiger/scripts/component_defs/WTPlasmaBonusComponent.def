<WTPlasmaBonusComponent.def>
  <CellMethods></CellMethods>
  <ClientMethods></ClientMethods>
  <Properties>
    <plasmaBonusPerVehicle>
      <Type>	ARRAY	  <of>	TUPLE	  <of>	UINT32	</of>
          <size>	2	</size>
        </of>
      </Type>
      <Flags>	ALL_CLIENTS	</Flags>
      <AllowUnsafeData>	true	</AllowUnsafeData>
    </plasmaBonusPerVehicle>
    <plasmaBonusLevelMultipliers>
      <Type>	ARRAY	  <of>	FLOAT32	</of>
      </Type>
      <Flags>	ALL_CLIENTS	</Flags>
      <AllowUnsafeData>	true	</AllowUnsafeData>
    </plasmaBonusLevelMultipliers>
  </Properties>
  <ofEntity>
    <ArenaInfo></ArenaInfo>
  </ofEntity>
  <DefaultKeyName>	wtPlasmaBonusComponent	</DefaultKeyName>
</WTPlasmaBonusComponent.def>
